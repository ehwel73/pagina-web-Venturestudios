{%- comment -%}
  Venture Studios: enlace a la página de favoritos con el número de prendas guardadas.
  La página se crea en Shopify con el identificador "wishlist" y la plantilla "wishlist".
{%- endcomment -%}
{%- liquid
  if routes.root_url == '/'
    assign fav_url = '/pages/wishlist'
  else
    assign fav_url = routes.root_url | append: '/pages/wishlist'
  endif
-%}
<a href="{{ fav_url }}" class="venture-fav-enlace {{ class }}">
  <span class="venture-header-text">{{ 'venture.favoritos.title' | t }}</span>
  <span class="venture-fav-enlace__numero" data-venture-fav-count hidden></span>
</a>
