{%- comment -%}
  Venture Studios: franja de texto en movimiento (bucle continuo).
  Cada bloque es un texto. Se detiene al pasar el ratón y respeta "reducir movimiento" del sistema.
{%- endcomment -%}

{{ 'venture-sections.css' | asset_url | stylesheet_tag }}

{%- capture items -%}
  {%- for block in section.blocks -%}
    <span class="venture-marquee__item" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="venture-marquee__link">{{ block.settings.text | escape }}</a>
      {%- else -%}
        {{ block.settings.text | escape }}
      {%- endif -%}
    </span>
    {%- if section.settings.show_separator -%}
      <span class="venture-marquee__separator" aria-hidden="true"></span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  id="Marquee-{{ section.id }}"
  class="venture-marquee color-{{ section.settings.color_scheme }} gradient venture-marquee--{{ section.settings.size }}{% if section.settings.show_borders %} venture-marquee--borders{% endif %}{% unless section.settings.show_separator %} venture-marquee--sin-separador{% endunless %}"
  style="--venture-marquee-duration: {{ section.settings.speed }}s; --venture-marquee-gap: {{ section.settings.gap }}px;"
>
  {%- if section.blocks.size > 0 -%}
    <div class="venture-marquee__track{% if section.settings.direction == 'right' %} venture-marquee__track--reverse{% endif %}">
      <div class="venture-marquee__group">{{ items }}{{ items }}</div>
      <div class="venture-marquee__group" aria-hidden="true">{{ items }}{{ items }}</div>
    </div>
  {%- endif -%}
</div>

<script>
  /* Rellena la tira con las repeticiones necesarias para cubrir todo el ancho: así el bucle
     nunca deja un hueco a la derecha, por corto que sea el texto. */
  (function () {
    var root = document.getElementById('Marquee-{{ section.id }}');
    if (!root) return;
    var groups = root.querySelectorAll('.venture-marquee__group');
    if (groups.length < 2) return;
    var base = groups[0].innerHTML;
    var lastWidth = 0;

    function fill() {
      var width = root.offsetWidth;
      if (!width || width === lastWidth) return;
      lastWidth = width;
      groups[0].innerHTML = base;
      var guard = 0;
      while (groups[0].scrollWidth < width && guard < 30) {
        groups[0].insertAdjacentHTML('beforeend', '<span class="venture-marquee__copia" aria-hidden="true">' + base + '</span>');
        guard++;
      }
      groups[1].innerHTML = groups[0].innerHTML;
    }

    fill();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        lastWidth = 0;
        fill();
      });
    }
    var timer;
    window.addEventListener('resize', function () {
      clearTimeout(timer);
      timer = setTimeout(fill, 150);
    });
  })();
</script>

{% schema %}
{
  "name": "VS · Texto en movimiento",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Duración de una vuelta",
      "info": "Más segundos, más lento.",
      "default": 30
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Dirección",
      "options": [
        { "value": "left", "label": "Hacia la izquierda" },
        { "value": "right", "label": "Hacia la derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Tamaño del texto",
      "options": [
        { "value": "bar", "label": "Barra fina (anuncios)" },
        { "value": "small", "label": "Pequeño" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Punto entre textos",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "min": 16,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Separación entre textos",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Líneas arriba y abajo",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Venture Studios"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VS · Texto en movimiento",
      "blocks": [
        { "type": "item", "settings": { "text": "Venture Studios" } },
        { "type": "item", "settings": { "text": "Nueva colección" } },
        { "type": "item", "settings": { "text": "Ropa de calle" } }
      ]
    }
  ]
}
{% endschema %}
