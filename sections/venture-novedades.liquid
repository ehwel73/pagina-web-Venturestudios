{%- comment -%}
  Venture Studios: novedades con pestañas (por ejemplo Hombre y Mujer).
  Cada bloque es una pestaña con su colección. En móvil los productos se deslizan;
  en escritorio se muestran en cuadrícula de 4 columnas.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'venture-sections.css' | asset_url | stylesheet_tag }}

<div
  id="Novedades-{{ section.id }}"
  class="venture-novedades color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    <div class="venture-novedades__top">
      {%- if section.settings.heading != blank -%}
        <h2 class="venture-novedades__heading h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 1 -%}
        <div class="venture-novedades__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              id="Tab-{{ section.id }}-{{ forloop.index }}"
              class="venture-novedades__tab"
              aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {% unless forloop.first %}
                tabindex="-1"
              {% endunless %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.title | escape -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign tab_index = forloop.index -%}
      {%- assign tab_collection = block.settings.collection -%}
      <div
        id="Panel-{{ section.id }}-{{ tab_index }}"
        class="venture-novedades__panel"
        {% if section.blocks.size > 1 %}
          role="tabpanel" aria-labelledby="Tab-{{ section.id }}-{{ tab_index }}"
        {% endif %}
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <ul class="venture-novedades__list list-unstyled" role="list">
          {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
            {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
              <li class="venture-novedades__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: 'default',
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: false,
                  show_rating: false,
                  lazy_load: true,
                  section_id: section.id,
                  quick_add: 'none',
                  product_view_context: 'collection'
                %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {%- assign placeholder_image = 'product-apparel-' | append: i -%}
              <li class="venture-novedades__item">
                {% render 'card-product',
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: 'default',
                  lazy_load: false,
                  placeholder_image: placeholder_image
                %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {%- if tab_collection != blank -%}
          <a class="venture-novedades__all" href="{{ tab_collection.url }}">
            {{- 'sections.featured_collection.view_all' | t }} · {{ block.settings.title | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('Novedades-{{ section.id }}');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));

    function select(tab) {
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        select(tab);
      });
      tab.addEventListener('keydown', function (event) {
        var step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        var next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });

    // En el editor de temas: al elegir una pestaña en el panel lateral, se muestra.
    document.addEventListener('shopify:block:select', function (event) {
      var tab = event.target;
      if (tabs.indexOf(tab) !== -1) select(tab);
    });
  })();
</script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "VS · Novedades",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Novedades"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Productos por pestaña",
      "default": 8
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Formato de las fotos",
      "options": [
        { "value": "portrait", "label": "Vertical" },
        { "value": "square", "label": "Cuadrado" },
        { "value": "adapt", "label": "Según la foto" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Mostrar segunda foto al pasar el ratón",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "pestana",
      "name": "Pestaña",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de la pestaña",
          "default": "Hombre"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VS · Novedades",
      "blocks": [
        { "type": "pestana", "settings": { "title": "Hombre" } },
        { "type": "pestana", "settings": { "title": "Mujer" } }
      ]
    }
  ]
}
{% endschema %}
